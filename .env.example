# Токен бота из BotFather (@BotFather -> /newbot)
BOT_TOKEN=

# Telegram ID, куда приходят уведомления о заказах (узнать: @userinfobot)
ADMIN_ID=

# Публичный https-URL приложения после деплоя. Нужен для кнопки
# «Открыть магазин» и Menu Button. Пример: https://noir-store.up.railway.app
APP_URL=

# 1 = пускать без Telegram (демо-пользователь) — для браузера и скриншотов.
# В проде не включать.
DEV_MODE=0

# Сколько секунд initData считается свежим (по умолчанию сутки)
# AUTH_MAX_AGE=86400

# Пути; обычно не нужны
# DB_PATH=./data/noir.db
# FRONTEND_DIST=../frontend/dist
